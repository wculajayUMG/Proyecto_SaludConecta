SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
MASTER_ENCRYPTION_KEY=replace-with-a-url-safe-base64-key-for-32-bytes
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSLMODE=require
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1
JWT_COOKIE_SECURE=false
FLASK_DEBUG=false
PORT=5000
MODEL_PATH=modelo_espera.pkl
MFA_ISSUER_NAME=SaludConecta
BACKUP_OUTPUT_DIR=backups
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
